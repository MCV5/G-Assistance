# Database (Neon / Postgres)
DATABASE_URL=postgresql://...

# Email — required for verification codes (use Resend: https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Goalcery <onboarding@your-verified-domain.com>
# Optional — set to true before App Store to require email verification again
# REQUIRE_EMAIL_VERIFICATION=true

# USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup) — server-side only
USDA_FDC_API_KEY=

# Optional
APP_NAME=Goalcery
APP_DEEP_LINK_SCHEME=goalcery
EMAIL_VERIFICATION_BASE_URL=https://your-web-app.example.com

# Legacy SMTP instead of Resend:
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_FROM=Goalcery <noreply@example.com>
