{
  "expo": {
    "name": "Goalcery",
    "slug": "goalcery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goalcery",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.goalcery.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Goalcery uses the microphone so you can speak your shopping list.",
        "NSSpeechRecognitionUsageDescription": "Goalcery uses speech recognition to turn what you say into shopping list items."
      }
    },
    "android": {
      "package": "com.goalcery.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Goalcery to use the camera to scan barcodes."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Goalcery uses the microphone so you can speak your shopping list.",
          "speechRecognitionPermission": "Goalcery uses speech recognition to turn what you say into shopping list items."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://g-assistance.onrender.com",
      "eas": {
        "projectId": "3c7f95a6-4bfb-449d-a521-0568a58d70d9"
      }
    },
    "owner": "manoharcv5"
  }
}
